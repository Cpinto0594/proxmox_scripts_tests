# Copy into the Dokploy app's Environment tab. Real values live in Infisical.

# --- Image (check https://github.com/goauthentik/authentik/releases before bumping) ---
AUTHENTIK_TAG=2026.8.5

# --- Secret key (never change after first start) ---
# infisical:/homelab/authentik/secret-key   ->  openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# --- External database (role + DB created by hand, see docs/services/authentik.md) ---
# Default: Patroni cluster VIP through HAProxy on 54321 (always routes to the current primary).
# Not 5432: on the VIP that hits Postgres on whichever node holds the VIP, which may be a replica.
PG_HOST=192.168.40.120
PG_PORT=54321
PG_USER=authentik
# infisical:/homelab/authentik/db-password  ->  openssl rand -hex 32
PG_PASS=
PG_DB=authentik
# disable | allow | prefer | require | verify-ca | verify-full
PG_SSLMODE=prefer

# --- First-run bootstrap (optional; only read on the very first start) ---
# infisical:/homelab/authentik/bootstrap-password
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=

# --- Email (optional) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=cpinto0594@gmail.com
# infisical:/homelab/authentik/smtp-password
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_FROM=cpinto0594@gmail.com

# --- Domain ---
PUBLIC_DOMAIN=authentik.homelab.capilabs.dev
LOCAL_DOMAIN=authentik.home.capilabs.dev
