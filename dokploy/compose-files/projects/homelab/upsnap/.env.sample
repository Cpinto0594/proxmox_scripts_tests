# --- Listen address (host network on docker-dev-1) ---
# Must match the server URL in dokploy/traefik/dynamic/upsnap.yml.
# TODO: confirm 8090 is free on docker-dev-1: ss -ltnp | grep 8090
UPSNAP_LISTEN=192.168.40.10:8090

# --- App ---
TZ=America/Bogota
UPSNAP_INTERVAL=*/30 * * * * *
UPSNAP_SCAN_RANGE=192.168.1.0/24
UPSNAP_WEBSITE_TITLE=Homelab WoL

# --- Domain (route is in the Traefik file provider, not labels) ---
LOCAL_DOMAIN=upsnap.home.capilabs.dev
